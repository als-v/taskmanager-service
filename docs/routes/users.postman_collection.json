{
  "info": {
    "_postman_id": "5955dc87-fb11-4529-934d-61543eda90c2",
    "name": "users",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "8619752"
  },
  "item": [
    {
      "name": "/",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set(\"user_id\", null);",
              "",
              "if (pm.response.code === 200) {",
              "      const body = pm.response.json();",
              "",
              "    if (body.content.length > 0) {",
              "        pm.environment.set(\"user_id\", body.content[0].id);",
              "    }",
              "  }"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{TASKMANAGER_API_URL}}/users",
          "host": [
            "{{TASKMANAGER_API_URL}}"
          ],
          "path": [
            "users"
          ],
          "query": [
            {
              "key": "name",
              "value": "Usuario",
              "type": "text",
              "disabled": true
            },
            {
              "key": "email",
              "value": "usuario@usuario.com",
              "type": "text",
              "disabled": true
            },
            {
              "key": "project_id",
              "value": "{{project_id}}",
              "type": "text",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    }
  ]
