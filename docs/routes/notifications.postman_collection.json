  "item": [
    {
      "name": "/",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set(\"notification_id\", null);",
              "",
              "if (pm.response.code === 200) {",
              "      const body = pm.response.json();",
              "",
              "    if (body.content.length > 0) {",
              "        pm.environment.set(\"notification_id\", body.content[0].id);",
              "    }",
              "  }"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
